# Python Code: Solution to Primal Problem of von Neumann entropy SDP against Quantum Adversaries (https://arxiv.org/pdf/2610.05766)
# The function build_vn_quantum_solver(E,w,k) computes lower bounds on von Neumann entropy                                                                                       


# Import packages.
import cvxpy as cp
import numpy as np
from scipy.stats import entropy

#Example Choice
#k = 16                     #  Number of line segments used to approximate the function H(E)
#E = [0,1]                 #  Measured correlations
#w = [0.15,0.15]                 #  Assumed max-averages (energy-constraint assumption)


def h2(p):
    """
    Binary entropy in bits.
    """

    p = float(p)

    if p <= 0.0 or p >= 1.0:
        return 0.0

    return (
        -p*np.log2(p)
        -(1-p)*np.log2(1-p)
    )

def HE(E):
    """
    h_2((1-E)/2)
    """
    return h2((1-E)/2)


def Hq(q):
    """
    h_2((1-sqrt(q))/2)
    """
    return h2((1-np.sqrt(q))/2)

def Hq_prime(q):
    """
    Derivative of

        h_2((1-sqrt(q))/2).

    For q > 0:

        Hq'(q)
        =
        1/(4 sqrt(q))
        log_2((1-sqrt(q))/(1+sqrt(q))).

    At q = 0 we use the continuous limit

        -1/(2 ln 2).
    """

    if abs(q) < 1e-14:
        return -1/(2*np.log(2))

    sq = np.sqrt(q)

    return (
        1/(4*sq)
        *
        np.log2(
            (1-sq)/(1+sq)
        )
    )


def build_vn_quantum_solver(E,w,k):
    
    E = np.asarray(E, dtype=float)
    w = np.asarray(w, dtype=float)
    
    number_lambda = k*k
    
    ## Parameters
    #k = 16                     #  Number of line segments used to approximate the function H(E)
    w_peak = 1                #  Max peak assumption. If not utilized, simply set it to 1
    #E = [0,1]                 #  Measured correlations
    #w = [0.15,0.15]                 #  Assumed max-averages (energy-constraint assumption)
    p_x0 = 1                        # Prob of chossing setting x=0
    
    
    # Uniform grids from Proposition 12:
    #
    # E_i = -1 + 2i/k
    # q_j = j/k

    E_values = np.linspace(-1, 1, k+1)
    q_values = np.linspace(0, 1, k+1)
    
    
    
    
    # ========================================================
    # VARIABLES
    # ========================================================

    # p_lambda (These are the Pr(lambda) where we can assume there are at most k^2 different ones)
    Problambda = cp.Variable(number_lambda)

    # p_lambda * E_x^lambda
    Etildelambda = cp.Variable((number_lambda, 2))

    # p_lambda * omega_x^lambda
    omegatildelambda = cp.Variable((number_lambda, 2))

    # p_lambda * q^lambda
    qtildelambda = cp.Variable(number_lambda)

    # p_lambda * t^lambda
    ttildelambda = cp.Variable(number_lambda)

    # p_lambda * z_x^lambda
    ztildelambda = cp.Variable((number_lambda, 2))


    # ========================================================
    # EXTRA VARIABLES FOR Q
    # ========================================================

    tildeu = cp.Variable(number_lambda)
    tildev = cp.Variable(number_lambda)

    tildeeta = cp.Variable((number_lambda, 2))

    
    # ========================================================
    # PSD MATRICES
    # ========================================================

    # X_Q:
    #
    # homogenized 4x4 representation of Q

    X_Q = []

    # X_0:
    #
    # first q_* PSD constraint

    X_0 = []

    # X_1:
    #
    # second q_* PSD constraint

    X_1 = []

    for i in range(number_lambda):

        X_Q.append(
            cp.Variable(
                (4,4),
                symmetric=True
            )
        )

        X_0.append(
            cp.Variable(
                (3,3),
                symmetric=True
            )
        )

        X_1.append(
            cp.Variable(
                (3,3),
                symmetric=True
            )
        )


    # ========================================================
    # CONSTRAINTS
    # ========================================================
    
    constraints = []

    # ========================================================
    # PSD CONSTRAINTS
    # ========================================================

    constraints += [
        X_Q[i] >> 0
        for i in range(number_lambda)
    ]

    constraints += [
        X_0[i] >> 0
        for i in range(number_lambda)
    ]

    constraints += [
        X_1[i] >> 0
        for i in range(number_lambda)
    ]


    # ========================================================
    # RELATE X_Q TO VARIABLES
    #
    # X_Q =
    #
    # [ p       u       E0       2 eta0 - p ]
    # [ u       p       E1       2 eta1 - p ]
    # [ E0      E1      p        v          ]
    # [ 2eta0-p 2eta1-p v        p          ]
    #
    # ========================================================

    for i in range(number_lambda):

        constraints += [
            X_Q[i][0,0]
            ==
            Problambda[i]
        ]

        constraints += [
            X_Q[i][0,1]
            ==
            tildeu[i]
        ]

        constraints += [
            X_Q[i][0,2]
            ==
            Etildelambda[i,0]
        ]

        constraints += [
            X_Q[i][0,3]
            ==
            2*tildeeta[i,0]
            -
            Problambda[i]
        ]


        constraints += [
            X_Q[i][1,1]
            ==
            Problambda[i]
        ]

        constraints += [
            X_Q[i][1,2]
            ==
            Etildelambda[i,1]
        ]

        constraints += [
            X_Q[i][1,3]
            ==
            2*tildeeta[i,1]
            -
            Problambda[i]
        ]


        constraints += [
            X_Q[i][2,2]
            ==
            Problambda[i]
        ]

        constraints += [
            X_Q[i][2,3]
            ==
            tildev[i]
        ]


        constraints += [
            X_Q[i][3,3]
            ==
            Problambda[i]
        ]

    # ========================================================
    # FIRST q_* PSD MATRIX
    #
    # X_0 =
    #
    # [ qtilde    E0tilde   z0tilde ]
    # [ E0tilde   p         ttilde  ]
    # [ z0tilde   ttilde    p       ]
    #
    # ========================================================

    for i in range(number_lambda):

        constraints += [
            X_0[i][0,0]
            ==
            qtildelambda[i]
        ]

        constraints += [
            X_0[i][0,1]
            ==
            Etildelambda[i,0]
        ]

        constraints += [
            X_0[i][0,2]
            ==
            ztildelambda[i,0]
        ]

        constraints += [
            X_0[i][1,1]
            ==
            Problambda[i]
        ]

        constraints += [
            X_0[i][1,2]
            ==
            ttildelambda[i]
        ]

        constraints += [
            X_0[i][2,2]
            ==
            Problambda[i]
        ]


    # ========================================================
    # SECOND q_* PSD MATRIX
    #
    # X_1 =
    #
    # [ p         E1tilde   z1tilde ]
    # [ E1tilde   p         ttilde  ]
    # [ z1tilde   ttilde    p       ]
    #
    # ========================================================

    for i in range(number_lambda):

        constraints += [
            X_1[i][0,0]
            ==
            Problambda[i]
        ]

        constraints += [
            X_1[i][0,1]
            ==
            Etildelambda[i,1]
        ]

        constraints += [
            X_1[i][0,2]
            ==
            ztildelambda[i,1]
        ]

        constraints += [
            X_1[i][1,1]
            ==
            Problambda[i]
        ]

        constraints += [
            X_1[i][1,2]
            ==
            ttildelambda[i]
        ]

        constraints += [
            X_1[i][2,2]
            ==
            Problambda[i]
        ]
        
    # ========================================================
    # CONSTRAINTS ON p_lambda
    # ========================================================

    constraints += [
        Problambda[i] >= 0
        for i in range(number_lambda)
    ]

    constraints += [
        cp.sum(Problambda) == 1
    ]


    # ========================================================
    # CONSTRAINTS ON p_lambda E_x^lambda
    # ========================================================

    constraints += [
        Etildelambda[i,0]
        <=
        Problambda[i]
        for i in range(number_lambda)
    ]

    constraints += [
        Etildelambda[i,0]
        >=
        -Problambda[i]
        for i in range(number_lambda)
    ]

    constraints += [
        Etildelambda[i,1]
        <=
        Problambda[i]
        for i in range(number_lambda)
    ]

    constraints += [
        Etildelambda[i,1]
        >=
        -Problambda[i]
        for i in range(number_lambda)
    ]


    # ========================================================
    # CONSTRAINTS ON p_lambda omega_x^lambda
    # ========================================================

    constraints += [
        omegatildelambda[i,0]
        >=
        0
        for i in range(number_lambda)
    ]

    constraints += [
        omegatildelambda[i,1]
        >=
        0
        for i in range(number_lambda)
    ]

    constraints += [
        omegatildelambda[i,0]
        <=
        Problambda[i]*w_peak
        for i in range(number_lambda)
    ]

    constraints += [
        omegatildelambda[i,1]
        <=
        Problambda[i]*w_peak
        for i in range(number_lambda)
    ]



    # ========================================================
    # eta <= omega
    #
    # Needed for Qtilde.
    # ========================================================

    constraints += [
        tildeeta[i,0]
        <=
        omegatildelambda[i,0]
        for i in range(number_lambda)
    ]

    constraints += [
        tildeeta[i,1]
        <=
        omegatildelambda[i,1]
        for i in range(number_lambda)
    ]

    # ========================================================
    # q CONSTRAINTS
    #
    # 0 <= qtilde <= p
    # ========================================================

    constraints += [
        qtildelambda[i] >= 0
        for i in range(number_lambda)
    ]

    constraints += [
        qtildelambda[i]
        <=
        Problambda[i]
        for i in range(number_lambda)
    ]

    # ========================================================
    # z CONSTRAINTS
    #
    # p >= ztilde_x >= p - 2 omega_tilde_x
    # ========================================================

    constraints += [
        ztildelambda[i,0]
        <=
        Problambda[i]
        for i in range(number_lambda)
    ]

    constraints += [
        ztildelambda[i,0]
        >=
        Problambda[i]
        -
        2*omegatildelambda[i,0]
        for i in range(number_lambda)
    ]

    constraints += [
        ztildelambda[i,1]
        <=
        Problambda[i]
        for i in range(number_lambda)
    ]

    constraints += [
        ztildelambda[i,1]
        >=
        Problambda[i]
        -
        2*omegatildelambda[i,1]
        for i in range(number_lambda)
    ]

    # ========================================================
    # OPTIONAL EXPLICIT t BOUNDS
    #
    # Already implied by X_0/X_1 >= 0,
    # but useful to keep visible.
    # ========================================================

    constraints += [
        ttildelambda[i]
        <=
        Problambda[i]
        for i in range(number_lambda)
    ]

    constraints += [
        ttildelambda[i]
        >=
        -Problambda[i]
        for i in range(number_lambda)
    ]

    # ========================================================
    # AVERAGE OBSERVED E_x
    # ========================================================

    constraints += [
        cp.sum(
            Etildelambda[:,0]
        )
        ==
        E[0]
    ]

    constraints += [
        cp.sum(
            Etildelambda[:,1]
        )
        ==
        E[1]
    ]

    # ========================================================
    # AVERAGE ENERGY CONSTRAINTS
    #
    # Sum p_lambda omega_x^lambda <= omega_x
    # ========================================================

    constraints += [
        cp.sum(
            omegatildelambda[:,0]
        )
        <=
        w[0]
    ]

    constraints += [
        cp.sum(
            omegatildelambda[:,1]
        )
        <=
        w[1]
    ]        
    
    # ========================================================
    # PIECEWISE LINEAR OBJECTIVE
    # ========================================================

    A = np.zeros(number_lambda)
    B = np.zeros(number_lambda)
    C = np.zeros(number_lambda)




    # ========================================================
    # LOOP OVER (E,q) PARTITION
    #
    # lambda = i*k + j
    #
    # E interval:
    #
    # [E_i,E_{i+1}]
    #
    # q interval:
    #
    # [q_j,q_{j+1}]
    # ========================================================

    for i in range(k):

        Ei = E_values[i]
        Eip1 = E_values[i+1]


        # ----------------------------------------------------
        # CHORD OF h2((1-E)/2)
        #
        # K_i(E) = a_E + b_E E
        # ----------------------------------------------------

        b_E = (
            HE(Eip1)
            -
            HE(Ei)
        ) / (
            Eip1
            -
            Ei
        )

        a_E = (
            HE(Ei)
            -
            b_E*Ei
        )


        for j in range(k):

            qj = q_values[j]
            qjp1 = q_values[j+1]

            lam = i*k + j


            # ------------------------------------------------
            # TANGENT OF
            #
            # Hq(q)
            # =
            # h2((1-sqrt(q))/2)
            #
            # L_j(q)
            # =
            # a_q + b_q q
            # ------------------------------------------------

            b_q = Hq_prime(qj)

            a_q = (
                Hq(qj)
                -
                b_q*qj
            )


            # ------------------------------------------------
            # g(E,q)
            #
            # =
            # K_i(E) - L_j(q)
            #
            # =
            # A + B E + C q
            # ------------------------------------------------

            A[lam] = (
                a_E
                -
                a_q
            )

            B[lam] = b_E

            C[lam] = -b_q


            # =================================================
            # PARTITION CONSTRAINTS
            #
            # p E_i
            # <=
            # Etilde_0
            # <=
            # p E_{i+1}
            #
            # p q_j
            # <=
            # qtilde
            # <=
            # p q_{j+1}
            # =================================================

            constraints += [
                Etildelambda[lam,0]
                >=
                Problambda[lam]*Ei
            ]

            constraints += [
                Etildelambda[lam,0]
                <=
                Problambda[lam]*Eip1
            ]


            constraints += [
                qtildelambda[lam]
                >=
                Problambda[lam]*qj
            ]

            constraints += [
                qtildelambda[lam]
                <=
                Problambda[lam]*qjp1
            ]


    # ========================================================
    # OBJECTIVE
    #
    # sum_lambda
    #
    # A_lambda p_lambda
    # +
    # B_lambda Etilde_0^lambda
    # +
    # C_lambda qtilde^lambda
    # ========================================================

    obj = 0

    for i in range(number_lambda):

        obj += (
            A[i]*Problambda[i]
            +
            B[i]*Etildelambda[i,0]
            +
            C[i]*qtildelambda[i]
        )    
    
    # ========================================================
    # SOLVE
    # ========================================================

    prob = cp.Problem(
        cp.Minimize(obj),
        constraints
    )

    prob.solve(
        solver=cp.MOSEK,
        verbose=False
    )    
   


    # ========================================================
    # STATUS CHECK
    # ========================================================

    if prob.status not in [
        "optimal",
        "optimal_inaccurate"
    ]:

        raise RuntimeError(
            f"Solver failed with status: {prob.status}"
        )


    # ========================================================
    # RETURN LOWER BOUND ON H(A|E Lambda, X=0)
    # ========================================================

    return prob.value




